{
  "name": "dev.corbie.frontend",
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start:www": "ng serve www.corbie.dev",
    "start:api": "ng serve api.corbie.dev",
    "build:apps": "ng build www.corbie.dev && ng build api.corbie.dev",
    "build:libs": "ng build @libs/icons && ng build @libs/header && ng build @libs/local-storage && ng build @libs/clipboard && ng build @libs/input-range && ng build @libs/nav && ng build @libs/http404",
    "test:e2e": "cucumber-js",
    "test:report": "node test/report.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.9",
    "@angular/compiler": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@angular/forms": "^21.2.15",
    "@angular/platform-browser": "^21.2.9",
    "@angular/router": "^21.2.15",
    "@corbie.dev/color-convert": "^1.1.0",
    "@corbie.dev/lorem-image": "^1.0.1",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.15",
    "@cucumber/cucumber": "^12.9.0",
    "@playwright/test": "^1.60.0",
    "@types/jasmine": "^5.1.15",
    "@types/node": "^25.9.1",
    "baseline-browser-mapping": "^2.10.32",
    "cucumber-html-reporter": "^7.2.0",
    "jasmine-core": "^5.13.0",
    "jsdom": "^27.4.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "ng-packagr": "^21.2.3",
    "playwright": "^1.60.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
